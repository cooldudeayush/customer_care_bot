# ---------------------------------------------------------------------------
# Customer Care Bot -- backend environment template.
# Copy this file to backend/.env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# App
APP_ENV=local
APP_NAME=customer-care-bot
LOG_LEVEL=INFO

# LLM -- Gemini Flash (get a key from https://aistudio.google.com/apikey)
# Uses the CURRENT unified google-genai SDK (not deprecated google-generativeai).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_S=1.0

# Relational / mock-business store (Phase 3). Swap to Postgres/Supabase later.
DATABASE_URL=sqlite:///./data/app.db
# Mock business systems the agentic tools read/write (orders, payments, tickets).
BUSINESS_DATABASE_URL=sqlite:///./data/business.db

# Customer operational graph (Phase 4: Neo4j-in-Docker, later Aura).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# Document retrieval (Phase 2). 'vector' = local Gemini-embeddings + cosine store
# (reliable, no heavy deps). Paths are relative to backend/ (uvicorn cwd); the
# corpus lives at repo-root data/, hence ../data. LightRAG is a documented swap.
VECTOR_STORE=vector
CORPUS_DIR=../data/corpus
VECTOR_INDEX_PATH=../data/vectorstore/index.json
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
RETRIEVAL_TOP_K=4

# CORS -- comma-separated browser origins allowed to call this API.
# Include your local Next.js dev origin and your deployed Vercel URL.
CORS_ORIGINS=http://localhost:3000
