# ---------------------------------------------------------------------------
# Customer Care Bot — root .gitignore
# ---------------------------------------------------------------------------

# --- Secrets / env (NEVER commit; .env.example IS committed) ---
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Local data stores (generated; not committed) ---
*.db
*.sqlite
*.sqlite3
data/*.db
data/vectorstore/
data/chroma/
data/lightrag/
data/neo4j/

# --- Node / Next.js ---
node_modules/
.next/
out/
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Claude local settings ---
.claude/settings.local.json
